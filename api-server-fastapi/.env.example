# App
DEBUG=True
SECRET_KEY=change-this-to-a-long-random-string-in-production
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL + PostGIS) — matches docker-compose defaults
DATABASE_URL=postgresql://carpoolbuddies:carpoolbuddies@localhost:5432/carpoolbuddies

# Redis — matches docker-compose defaults
REDIS_URL=redis://localhost:6379

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (portal.azure.com)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Google Maps — server-side ONLY, never expose to frontend
GOOGLE_MAPS_API_KEY=

# Email (resend.com)
RESEND_API_KEY=
EMAIL_FROM=noreply@carpoolbuddies.co.il

# Cloudflare R2 file storage (optional for Sprint 0)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=carpoolbuddies
